<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ProgressBar?>

<VBox xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" fx:controller="com.yamigg.practicaconteo3.PrimaryController">
   <children>
      <Label text="Contar numeros de Click!" />
      <TextField fx:id="click" text= "0"/>
      <Button fx:id="btnContar" text="Contar!!" onAction="#btnContar"/>
      <Label text="Esperar 10 segundos" />
      <ProgressBar fx:id="progreso" progress="0.0"/>
      <Button fx:id="btnEsperar" text="¡Esperar!" onAction="#btnEsperar"/>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
